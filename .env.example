NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MEDIA_ORIGIN=
PAYLOAD_SECRET=replace-with-a-long-random-secret
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
MFA_REQUIRED=false
MFA_ENCRYPTION_KEY=
# Local development: no Docker or PostgreSQL required.
DB_DRIVER=sqlite
SQLITE_DATABASE_URL=file:./payload.db
# Production: set DB_DRIVER=postgres and provide a managed PostgreSQL URL.
DATABASE_URL=
# Temporary empty-database bootstrap for private staging; set false afterwards.
PAYLOAD_DB_PUSH=false
TRUST_PROXY=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CMS_BUILD_DATA=false
S3_BUCKET=
S3_REGION=auto
# Required when S3_BUCKET is set (use an S3 or R2 public endpoint).
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
